          {"json_comentario": "Atraso proposital para escalonamento"},
          {"acao": "bloquear", "arquivo": "banco_dados.db", "modo": "W"},
          {"acao": "processar", "tempo": 0.3},
          {"acao": "liberar", "arquivo": "banco_dados.db"}
        ]
      },
      {
        "nome": "Leitor_2", "usuario": "usuario_comum",
        "passos": [
          {"acao": "processar", "tempo": 0.2},
