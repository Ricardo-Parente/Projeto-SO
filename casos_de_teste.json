{
  "cenario_1_sucesso": {
    "descricao": "Execucao limpa. Processos respeitam a ACL e nao geram Deadlock.",
    "acl": {
      "relatorio.pdf": {"admin": ["R", "W"], "estagiario": ["R"]}
    },
    "processos": [
      {
        "nome": "P1_Admin", "usuario": "admin",
        "passos": [
          {"acao": "bloquear", "arquivo": "relatorio.pdf", "modo": "W"},
          {"acao": "processar", "tempo": 1.0},
          {"acao": "liberar", "arquivo": "relatorio.pdf"}
        ]
      },
      {
        "nome": "P2_Estagiario", "usuario": "estagiario",
        "passos": [
          {"acao": "bloquear", "arquivo": "relatorio.pdf", "modo": "R"},
          {"acao": "liberar", "arquivo": "relatorio.pdf"}
        ]
      }
    ]
  },
  "cenario_2_deadlock_resolvido": {
    "descricao": "Gera um Deadlock classico (A espera B, B espera A). O Monitor de SO deve detectar e abortar um deles.",
    "acl": {
      "db_clientes.dat": {"sistema": ["R", "W"]},
      "db_vendas.dat": {"sistema": ["R", "W"]}
    },
    "processos": [
      {
        "nome": "Thread_Sync_A", "usuario": "sistema",
        "passos": [
          {"acao": "bloquear", "arquivo": "db_clientes.dat", "modo": "W"},
          {"acao": "processar", "tempo": 0.5},
          {"acao": "bloquear", "arquivo": "db_vendas.dat", "modo": "W"},
          {"acao": "liberar", "arquivo": "db_clientes.dat"},
          {"acao": "liberar", "arquivo": "db_vendas.dat"}
        ]
      },
      {
        "nome": "Thread_Sync_B", "usuario": "sistema",
        "passos": [
          {"acao": "bloquear", "arquivo": "db_vendas.dat", "modo": "W"},
          {"acao": "processar", "tempo": 0.5},
          {"acao": "bloquear", "arquivo": "db_clientes.dat", "modo": "W"},
          {"acao": "liberar", "arquivo": "db_vendas.dat"},
          {"acao": "liberar", "arquivo": "db_clientes.dat"}
        ]
      }
    ]
  },
